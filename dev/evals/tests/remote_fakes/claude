#!/usr/bin/env python3
"""Stand-in for headless Claude Code in the remote.py tests.

Does a yolo run's visible work in the current checkout: a plan directory when
the prompt carries a task and none exists, a build commit, a ship commit with
review and pr.md, the push, and the pull request (through the fake gh). Each
step happens once, so a resumed session picks up where the last one stopped.
It keeps the session's transcript where Claude Code keeps it (a resume without
that transcript fails, as the real one does) and writes stream-json to stdout
like `--output-format stream-json`. FAKE_CLAUDE_MODE:

  ok              the first session finishes everything (default)
  early-once      the first session builds, then ends content before ship and the PR
  dirty-once      the first session leaves its ship change uncommitted
  api-error-once  the first session ends in a gateway 500 (subtype success, is_error)
  crash-once      the first session dies without a result
  never           no session ever opens the pull request
  blocked         the session writes blocked.md, as the contract says for a hard stop
  no-push         the push is rejected, so the session blocks after committing
  sleep           waits 60 s before working (for stop)
"""

import json
import os
import re
import subprocess
import sys
import time
import uuid
from pathlib import Path

VM = Path(os.environ["FAKE_VM"])
HOME = Path(os.environ["HOME"])
MODE = os.environ.get("FAKE_CLAUDE_MODE", "ok")


def opt(name: str) -> str | None:
    argv = sys.argv[1:]
    return argv[argv.index(name) + 1] if name in argv else None


def emit(event: dict) -> None:
    print(json.dumps(event), flush=True)


def git(*args: str) -> str:
    return subprocess.run(["git", *args], check=True, capture_output=True, text=True).stdout.strip()


def transcript_path(session: str) -> Path:
    """Where Claude Code keeps a session run in the current directory."""
    return HOME / ".claude" / "projects" / re.sub(r"[^A-Za-z0-9]", "-", os.getcwd()) / f"{session}.jsonl"


def commit(name: str, line: str, message: str) -> None:
    with open(name, "a") as handle:
        handle.write(line + "\n")
    git("add", name)
    git("commit", "-q", "-m", message)


def main() -> int:
    prompt = opt("-p") or ""
    resume = opt("--resume")
    session = resume or opt("--session-id") or str(uuid.uuid4())
    plugin = Path(opt("--plugin-dir") or "")
    contract = Path(opt("--append-system-prompt-file") or "").read_text()
    with (VM / "claude-calls.jsonl").open("a") as handle:
        handle.write(json.dumps({"prompt": prompt, "session": session, "resume": resume, "cwd": os.getcwd(),
                                 "argv": sys.argv[1:], "branch": git("branch", "--show-current"),
                                 "bg_wait_ms": os.environ.get("CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS")}) + "\n")
    assert (plugin / "skills" / "yolo" / "SKILL.md").exists(), "plugin copy is missing yolo"
    assert not re.search(r"\{(plugin|run|branch|default)\}", contract), "contract placeholders left unrendered"
    if resume and not transcript_path(resume).exists():  # as Claude Code does without the transcript
        print(f"No conversation found with session ID: {resume}", file=sys.stderr)
        return 1
    emit({"type": "system", "subtype": "init", "session_id": session, "model": "fake"})
    transcript = transcript_path(session)
    transcript.parent.mkdir(parents=True, exist_ok=True)
    with transcript.open("a") as handle:  # Claude Code writes the transcript from the first turn on
        handle.write(json.dumps({"type": "user", "message": prompt, "cwd": os.getcwd()}) + "\n")
    first = not (VM / "first-session-done").exists()
    (VM / "first-session-done").write_text("1")
    if first and MODE == "api-error-once":
        emit({"type": "assistant", "message": {"content": [
            {"type": "text", "text": "API Error: 500 litellm.InternalServerError: Connection error."}]}})
        emit({"type": "result", "subtype": "success", "is_error": True, "num_turns": 1})
        return 1
    if first and MODE == "crash-once":
        raise SystemExit("fake claude: crashed")
    if MODE == "sleep":
        time.sleep(60)
    emit({"type": "assistant", "message": {"content": [
        {"type": "text", "text": "Working on the run"},
        {"type": "tool_use", "name": "Bash", "input": {"command": "git status", "description": "Show status"}}]}})
    blocked = Path(re.search(r"`(\S+/blocked\.md)`", contract).group(1))
    if MODE == "blocked":
        blocked.write_text("The gauntlet found a committed secret in config/prod.env.\n")
        emit({"type": "result", "subtype": "success", "is_error": False, "num_turns": 2, "duration_ms": 900})
        return 0
    plans = [p for p in Path(".dev").iterdir() if p.is_dir()] if Path(".dev").is_dir() else []
    if not plans:  # a task, not a plan: yolo's scope stage writes the plan
        plans = [Path(".dev/from-task")]
        plans[0].mkdir(parents=True)
        (plans[0] / "spec.md").write_text(f"# From the task\n\n{prompt}\n")
    plan = plans[0]
    log = git("log", "--format=%s")
    if "feat: build the feature" not in log:
        commit("feature.txt", "built", "feat: build the feature")
        (plan / "implementation-notes.md").write_text("## Change set 1\n\nDone.\n")
    if not (first and MODE == "early-once"):
        if Path("ship.txt").exists() and git("status", "--porcelain"):
            git("add", "ship.txt")
            git("commit", "-q", "-m", "fix: harden after review")
        elif "fix: harden after review" not in log:
            if first and MODE == "dirty-once":
                Path("ship.txt").write_text("hardened\n")
            else:
                commit("ship.txt", "hardened", "fix: harden after review")
        if "The operator adds" in prompt and resume:
            commit("extra.txt", prompt.split("The operator adds:")[1].strip(), "feat: the operator's addition")
        (plan / "review_1.md").write_text("# Review\n\nVerdict: PASS\n")
        (plan / "pr.md").write_text("## Summary\n\nDemo.\n\n## Open calls\n\nnone\n")
        if not git("status", "--porcelain") and MODE != "never":
            branch = git("branch", "--show-current")
            if MODE == "no-push":
                blocked.write_text("git push was rejected: the instance has no write access to origin.\n")
            else:
                git("push", "-q", "-u", "origin", branch)
                if not (VM / "pr.json").exists():
                    # As the real agent does: no --head, so gh has to find the branch's remote itself.
                    subprocess.run(["gh", "pr", "create", "--base", "main", "--title", "Greeting",
                                    "--body-file", str(plan / "pr.md")], check=True, capture_output=True)
    for count in range(400):  # the real stream is mostly these progress ticks
        emit({"type": "system", "subtype": "thinking_tokens", "session_id": session, "tokens": count})
    emit({"type": "result", "subtype": "success", "is_error": False, "num_turns": 3, "duration_ms": 1200})
    return 0


if __name__ == "__main__":
    sys.exit(main())
