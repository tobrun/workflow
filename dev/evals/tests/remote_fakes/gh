#!/usr/bin/env bash
# Stand-in for `gh` in the remote.py tests.
#   gh auth status                 signed in when FAKE_GH=signed-in
#   gh pr create ...               needs --head and GH_REPO, as behind the relay, and a pushed
#                                  branch; writes $FAKE_VM/pr.json
#   gh pr view BRANCH --json ...   the PR the fake claude opened, its headRefOid read from origin
#                                  as GitHub would report it; needs GH_REPO or --repo, as behind
#                                  the fleet's insteadOf relay
set -Eeuo pipefail
case "${1:-} ${2:-}" in
  "auth status") [ "${FAKE_GH:-}" = signed-in ] || { echo "You are not logged into any GitHub hosts." >&2; exit 1; } ;;
  "pr view") case " $* " in *" --repo "*|*" -R "*) ;; *)
               # Real gh infers the repository from the remotes, which an insteadOf rewrite hides.
               [ -n "${GH_REPO:-}" ] || { echo "none of the git remotes configured for this repository point to a known GitHub host" >&2; exit 1; } ;;
             esac
             [ -f "${FAKE_VM:?}/pr.json" ] || { echo "no pull requests found for branch \"$3\"" >&2; exit 1; }
             head=$(git ls-remote origin "refs/heads/$3" | cut -f1)
             python3 -c 'import json, sys
pr = json.load(open(sys.argv[1])); pr["headRefOid"] = sys.argv[2]; print(json.dumps(pr))' "$FAKE_VM/pr.json" "$head" ;;
  "pr create") head=""; draft=false; prev=""
             for arg in "$@"; do
               case $prev in --head|-H) head=$arg ;; esac
               case $arg in --head=*) head=${arg#--head=} ;; --draft) draft=true ;; esac
               prev=$arg
             done
             # Real gh resolves the branch's push remote here, even with GH_REPO set.
             [ -n "$head" ] || { echo "could not resolve remote \"origin\": none of the git remotes configured for this repository point to a known GitHub host" >&2; exit 1; }
             [ -n "${GH_REPO:-}" ] || { echo "none of the git remotes configured for this repository point to a known GitHub host" >&2; exit 1; }
             [ -n "$(git ls-remote origin "refs/heads/$head")" ] || { echo "pull request create failed: Head sha can't be blank (the branch is not pushed)" >&2; exit 1; }
             printf '{"url": "https://example.test/pr/7", "number": 7, "state": "OPEN", "isDraft": %s}' "$draft" >"${FAKE_VM:?}/pr.json"
             echo "https://example.test/pr/7" ;;
  *) echo "fake gh: unsupported $*" >&2; exit 2 ;;
esac
