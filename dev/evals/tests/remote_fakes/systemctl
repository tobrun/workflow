#!/usr/bin/env python3
"""Stand-in for `systemctl` inside a fake VM: units are pid files under $FAKE_VM/units.

`stop` signals the unit's whole process tree, as systemd signals every process in the
unit's cgroup: a child that left the runner's process group (GNU timeout puts the
command it runs in its own) is still part of the unit.
"""

import os
import signal
import subprocess
import sys
import time
from pathlib import Path

UNITS = Path(os.environ["FAKE_VM"]) / "units"


def pid_of(unit: str) -> int | None:
    path = UNITS / f"{unit}.pid"
    return int(path.read_text()) if path.exists() else None


def alive(pid: int | None) -> bool:
    if pid is None:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    try:  # a reaped-late zombie still answers kill(0)
        waited, _ = os.waitpid(pid, os.WNOHANG)
        return waited == 0
    except ChildProcessError:
        return True


def tree(pid: int) -> list[int]:
    """pid and every process descended from it."""
    rows = subprocess.run(["ps", "-A", "-o", "pid=", "-o", "ppid="], capture_output=True, text=True).stdout
    children: dict[int, list[int]] = {}
    for row in rows.splitlines():
        parts = row.split()
        if len(parts) == 2:
            children.setdefault(int(parts[1]), []).append(int(parts[0]))
    found, todo = [], [pid]
    while todo:
        current = todo.pop()
        found.append(current)
        todo.extend(children.get(current, []))
    return found


def main() -> int:
    args = [a for a in sys.argv[1:] if a != "--quiet"]
    verb, unit = args[0], args[-1]
    pid = pid_of(unit)
    if verb == "is-active":
        return 0 if alive(pid) else 3
    if verb == "stop":
        if alive(pid):
            for member in tree(pid):
                try:
                    os.kill(member, signal.SIGTERM)
                except ProcessLookupError:
                    pass
            for _ in range(100):
                if not alive(pid):
                    break
                time.sleep(0.1)
        return 0
    if verb == "reset-failed":
        return 0
    print(f"fake systemctl: unsupported {args}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
