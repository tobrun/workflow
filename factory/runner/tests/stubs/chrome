#!/usr/bin/env python3
"""Stub Chrome for factory runner tests: the CDP endpoint without a browser.

Records its argv to $FACTORY_STUB_LOG, honors `--remote-debugging-port=N` and
`--user-data-dir=DIR` the way Chrome does (it serves /json/version on 127.0.0.1:N
and writes DIR/DevToolsActivePort and DIR/stub.json), then waits for SIGTERM.
"""

import json
import os
import signal
import sys
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path


def option(argv, prefix):
    for part in argv:
        if part.startswith(prefix):
            return part[len(prefix):]
    return None


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):  # noqa: N802 - http.server API
        if self.path != "/json/version":
            self.send_response(404)
            self.end_headers()
            return
        body = json.dumps({"Browser": "StubChrome/1.0", "Protocol-Version": "1.3",
                           "webSocketDebuggerUrl": f"ws://127.0.0.1:{self.server.server_port}/devtools/browser/stub"})
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.end_headers()
        self.wfile.write(body.encode("utf-8"))

    def log_message(self, *args):
        pass


def main():
    argv = sys.argv[1:]
    log = os.environ.get("FACTORY_STUB_LOG")
    if log:
        with open(log, "a", encoding="utf-8") as handle:
            handle.write(json.dumps({"tool": "chrome", "argv": argv, "cwd": os.getcwd(), "pid": os.getpid()}) + "\n")
    port = int(option(argv, "--remote-debugging-port=") or 0)
    server = HTTPServer(("127.0.0.1", port), Handler)
    profile = option(argv, "--user-data-dir=")
    if profile:
        Path(profile).mkdir(parents=True, exist_ok=True)
        (Path(profile) / "DevToolsActivePort").write_text(f"{server.server_port}\n/devtools/browser/stub\n",
                                                          encoding="utf-8")
        # The runner hands the browser only a baseline environment, so the record lives in its profile directory.
        (Path(profile) / "stub.json").write_text(json.dumps({"argv": argv, "pid": os.getpid(),
                                                              "port": server.server_port}), encoding="utf-8")
    print(f"DevTools listening on ws://127.0.0.1:{server.server_port}/devtools/browser/stub", file=sys.stderr, flush=True)
    def terminate(*_):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, terminate)
    try:
        server.serve_forever(poll_interval=0.1)
    except SystemExit:
        pass
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
