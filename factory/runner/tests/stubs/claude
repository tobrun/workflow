#!/usr/bin/env python3
"""Stub `claude` for interactive scope.

Records argv to $FACTORY_STUB_LOG and plays launch N of the JSON list at
$FACTORY_CLAUDE_SCENARIO (the last entry repeats): {"files": {...},
"result": {...} | "omit", "exit": 0}. Placeholders come from .dev/factory-run.json.
"""

import json
import os
import sys
from pathlib import Path


def fill(value, context):
    if isinstance(value, str):
        for key, replacement in context.items():
            value = value.replace("{" + key + "}", str(replacement))
        return value
    if isinstance(value, dict):
        return {fill(k, context): fill(v, context) for k, v in value.items()}
    if isinstance(value, list):
        return [fill(item, context) for item in value]
    return value


def main():
    argv = sys.argv[1:]
    log = os.environ.get("FACTORY_STUB_LOG")
    launches = 0
    if log:
        if Path(log).exists():
            launches = sum(1 for line in Path(log).read_text(encoding="utf-8").splitlines()
                           if json.loads(line).get("tool") == "claude")
        with open(log, "a", encoding="utf-8") as handle:
            handle.write(json.dumps({
                "tool": "claude",
                "argv": argv,
                "cwd": os.getcwd(),
                "resume": "--resume" in argv,
                "session": argv[argv.index("--resume") + 1] if "--resume" in argv
                else (argv[argv.index("--session-id") + 1] if "--session-id" in argv else None),
                "env": {k: v for k, v in os.environ.items() if k.startswith("FACTORY_")},
            }) + "\n")
    run_file = Path(".dev/factory-run.json")
    run = json.loads(run_file.read_text(encoding="utf-8")) if run_file.exists() else {}
    scenario_path = os.environ.get("FACTORY_CLAUDE_SCENARIO")
    steps = json.loads(Path(scenario_path).read_text(encoding="utf-8")) if scenario_path else [{}]
    if isinstance(steps, dict):
        steps = [steps]
    step = steps[min(launches, len(steps) - 1)]
    context = {"plan": run.get("plan", ""), "report_dir": run.get("report_dir", ""), "run_id": run.get("run_id", "")}
    for relative, content in fill(step.get("files", {}), context).items():
        target = Path(relative)
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(content, encoding="utf-8")
    result = step.get("result", {})
    if result != "omit" and run:
        payload = {"schema": 2, "stage": "scope", "status": "done", "reason": "spec settled", "conditions": [],
                   "next": "scope-review"}
        payload.update(result)
        path = Path(".dev") / context["plan"] / "scope-result.json"
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(payload), encoding="utf-8")
    return int(step.get("exit", 0))


if __name__ == "__main__":
    sys.exit(main())
