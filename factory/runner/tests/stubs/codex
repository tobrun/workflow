#!/usr/bin/env python3
"""Stub `codex` for factory runner tests.

Records argv and environment to $FACTORY_STUB_LOG, then plays the step for the
current stage and attempt from the JSON scenario at $FACTORY_STUB_SCENARIO:

{"build": [{"files": {...}, "run": [[...]], "result": {...} | "omit" | "corrupt",
            "sleep": 1, "ignore_term": false, "exit": 0, "tokens": 100}, ...]}

The list is indexed by attempt; the last step repeats. Placeholders {plan},
{report_dir}, {evidence_dir}, {run_id}, {branch}, {stage}, {attempt}, {gh}
are filled from .dev/factory-run.json and the environment.
"""

import json
import os
import signal
import subprocess
import sys
import time
from pathlib import Path


def emit(event):
    sys.stdout.write(json.dumps(event) + "\n")
    sys.stdout.flush()


def fill(value, context):
    if isinstance(value, str):
        for key, replacement in context.items():
            value = value.replace("{" + key + "}", str(replacement))
        return value
    if isinstance(value, list):
        return [fill(item, context) for item in value]
    if isinstance(value, dict):
        return {fill(k, context): fill(v, context) for k, v in value.items()}
    return value


def option(argv, flag):
    if flag in argv:
        index = argv.index(flag)
        if index + 1 < len(argv):
            return argv[index + 1]
    return None


def foreman_turn(argv):
    """Play one foreman turn from $FACTORY_STUB_FOREMAN: a list indexed by $FACTORY_TURN, last step repeating.

    A step is a decision object (merged over schema, summary, rationale defaults), the string "invalid",
    "garbage", or "timeout", or an object with "mode", "exit", "sleep", "thread_id", "files", or "run".
    """
    resume = argv[:2] == ["exec", "resume"]
    last_message = option(argv, "-o")
    turn = int(os.environ.get("FACTORY_TURN", "1"))
    path = os.environ.get("FACTORY_STUB_FOREMAN")
    steps = json.loads(Path(path).read_text(encoding="utf-8")) if path and Path(path).exists() else []
    step = steps[min(turn, len(steps)) - 1] if steps else {"action": "park", "park": {
        "reason": "stub foreman has no scenario", "operator_action": "write a foreman scenario"}}
    if isinstance(step, str):
        step = {"mode": step}
    mode = step.get("mode")
    thread = step.get("thread_id") or (argv[2] if resume else "stub-foreman")
    emit({"type": "thread.started", "thread_id": thread})
    emit({"type": "turn.started"})
    if mode == "timeout":
        time.sleep(float(step.get("sleep", 30)))
    cwd = Path(os.getcwd())
    for relative, content in step.get("files", {}).items():
        target = Path(relative) if os.path.isabs(relative) else cwd / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(content, encoding="utf-8")
    for command in step.get("run", []):
        completed = subprocess.run(command, cwd=cwd, capture_output=True, text=True)
        emit({"type": "item.completed", "item": {"type": "command_execution", "command": " ".join(command),
                                                   "exit_code": completed.returncode, "status": "completed"}})
    if mode == "invalid":
        text = json.dumps({"schema": "factory.decision/1", "action": "fly", "summary": "s", "rationale": "r"})
    elif mode == "garbage":
        text = "I think we should just retry."
    else:
        decision = {"schema": "factory.decision/1", "summary": "stub decision", "rationale": "stub rationale"}
        body = step.get("decision") or {k: v for k, v in step.items()
                                        if k not in ("mode", "exit", "sleep", "thread_id", "files", "run", "tokens")}
        decision.update(body)
        text = json.dumps(decision)
    emit({"type": "item.completed", "item": {"type": "agent_message", "text": text}})
    tokens = int(step.get("tokens", 500))
    emit({"type": "turn.completed", "usage": {"input_tokens": tokens, "cached_input_tokens": 0,
                                               "output_tokens": tokens // 10}})
    if last_message and mode != "exit":
        Path(last_message).write_text(text + "\n", encoding="utf-8")
    return int(step.get("exit", 0))


def hindsight_turn(argv):
    """Play the labeller from $FACTORY_STUB_HINDSIGHT for the world in the working directory.

    The file holds one answer for every world, or a map from world (run) id to its answer. An answer is a
    factory.hindsight/1 record, "invalid" (outside the schema), or "auto": a label accepting the recorded
    foreman action (else advance) for every scorable point of world.json, and no faults.
    """
    last_message = option(argv, "-o")
    path = os.environ.get("FACTORY_STUB_HINDSIGHT")
    answers = json.loads(Path(path).read_text(encoding="utf-8")) if path and Path(path).exists() else "auto"
    world = json.loads(Path("world.json").read_text(encoding="utf-8"))
    answer = answers
    if isinstance(answers, dict) and answers.get("schema") is None:
        answer = answers.get(world["run"]["id"], "auto")
    if answer == "invalid":
        text = json.dumps({"schema": "factory.hindsight/1", "labels": [{"point": "nowhere-1", "accept": ["fly"]}]})
    elif answer == "auto":
        labels = []
        for point in world["points"]:
            if not point["scorable"]:
                continue
            recorded = (point.get("recorded_decision") or {})
            action = recorded.get("action") if recorded.get("vocabulary") == "decision" else "advance"
            labels.append({"point": point["id"], "accept": [action], "reject": ["cancel"] if action != "cancel" else [],
                           "allow_override": False, "note": f"{action}: the stub labeller accepts it"})
        text = json.dumps({"schema": "factory.hindsight/1", "labels": labels, "faults": []})
    else:
        text = json.dumps(answer)
    emit({"type": "thread.started", "thread_id": "stub-hindsight"})
    emit({"type": "item.completed", "item": {"type": "agent_message", "text": text}})
    emit({"type": "turn.completed", "usage": {"input_tokens": 100, "cached_input_tokens": 0, "output_tokens": 10}})
    if last_message:
        Path(last_message).write_text(text + "\n", encoding="utf-8")
    return 0


def replay_turn(argv):
    """Play a replayed foreman turn: the answer for the point in $FACTORY_REPLAY_POINT.

    The prompt names the skill it follows; a skill under a dream's staged `candidates/` tree answers from
    $FACTORY_STUB_REPLAY_CANDIDATE, any other from $FACTORY_STUB_REPLAY. Each file maps a point directory name,
    or `{world}/{point}`, to a decision object or "invalid"; an unmapped point parks.
    """
    last_message = option(argv, "-o")
    prompt = argv[1]
    skill = prompt.split("Follow the skill at ", 1)[1].split("\n", 1)[0] if "Follow the skill at " in prompt else ""
    variable = "FACTORY_STUB_REPLAY_CANDIDATE" if "/candidates/" in skill else "FACTORY_STUB_REPLAY"
    path = os.environ.get(variable)
    answers = json.loads(Path(path).read_text(encoding="utf-8")) if path and Path(path).exists() else {}
    point = os.environ.get("FACTORY_REPLAY_POINT", Path(os.getcwd()).name)
    world = Path(os.getcwd()).parent.parent.name
    step = answers.get(f"{world}/{point}", answers.get(point, answers.get("*")))
    if step == "invalid":
        text = json.dumps({"schema": "factory.decision/1", "action": "fly", "summary": "s", "rationale": "r"})
    else:
        decision = {"schema": "factory.decision/1", "summary": "stub replay", "rationale": "stub rationale"}
        decision.update(step or {"action": "park", "park": {"reason": "stub replay has no answer",
                                                            "operator_action": "map the point"}})
        text = json.dumps(decision)
    emit({"type": "thread.started", "thread_id": "stub-replay"})
    emit({"type": "item.completed", "item": {"type": "agent_message", "text": text}})
    emit({"type": "turn.completed", "usage": {"input_tokens": 100, "cached_input_tokens": 0, "output_tokens": 10}})
    if last_message:
        Path(last_message).write_text(text + "\n", encoding="utf-8")
    return 0



def main():
    argv = sys.argv[1:]
    log = os.environ.get("FACTORY_STUB_LOG")
    if log:
        with open(log, "a", encoding="utf-8") as handle:
            handle.write(json.dumps({
                "tool": "codex",
                "argv": argv,
                "cwd": os.getcwd(),
                "stdin_tty": os.isatty(0),
                "env": {k: v for k, v in os.environ.items() if k.startswith(("FACTORY_", "AGENT_BROWSER_")) or k in ("GH_TOKEN", "npm_config_cache")},
            }) + "\n")
    if argv[:2] == ["plugin", "list"]:
        source = os.environ.get("FACTORY_STUB_PLUGIN_SOURCE") or str(Path(__file__).resolve().parents[4] / "plugins" / "factory")
        print("Marketplace `nurbot`\n")
        print(f"factory@nurbot                          installed, enabled  0.1.0  {source}")
        return 0
    if argv[:1] == ["--version"]:
        print("codex-cli 0.0.0-stub")
        return 0
    if not argv or argv[0] != "exec":
        print(f"stub codex: unsupported {argv}", file=sys.stderr)
        return 64
    if os.environ.get("FACTORY_ROLE") == "foreman":
        return foreman_turn(argv)
    if os.environ.get("FACTORY_ROLE") == "hindsight":
        return hindsight_turn(argv)
    if os.environ.get("FACTORY_ROLE") == "replay":
        return replay_turn(argv)

    worktree = Path(option(argv, "-C") or os.getcwd())
    last_message = option(argv, "-o")
    if "FACTORY-SMOKE-OK" in argv[1]:
        skill = argv[1].split("$factory:", 1)[1].split()[0]
        answer = os.environ.get("FACTORY_STUB_SMOKE_ANSWER", f"FACTORY-SMOKE-OK {skill}")
        if last_message:
            Path(last_message).write_text(answer + "\n", encoding="utf-8")
        return 0
    run_file = worktree / ".dev" / "factory-run.json"
    run = json.loads(run_file.read_text(encoding="utf-8")) if run_file.exists() else {}
    stage = os.environ.get("FACTORY_STAGE", run.get("stage", "unknown"))
    attempt = int(os.environ.get("FACTORY_ATTEMPT", run.get("attempt", 1)))
    scenario_path = os.environ.get("FACTORY_STUB_SCENARIO")
    scenario = json.loads(Path(scenario_path).read_text(encoding="utf-8")) if scenario_path else {}
    if os.environ.get("FACTORY_ROLE") == "repair":
        # A repair plays "{stage}-repair", indexed by the repair ordinal; without one it writes a clean result.
        steps = scenario.get(f"{stage}-repair") or [{}]
        step = steps[min(int(os.environ.get("FACTORY_REPAIR", "1")), len(steps)) - 1]
    else:
        steps = scenario.get(stage) or [{}]
        step = steps[min(attempt, len(steps)) - 1]
    context = {
        "plan": run.get("plan", os.environ.get("FACTORY_PLAN", "")),
        "report_dir": run.get("report_dir", ""),
        "evidence_dir": run.get("evidence_dir", ""),
        "run_id": run.get("run_id", ""),
        "branch": run.get("branch", ""),
        "stage": stage,
        "attempt": attempt,
        "gh": os.environ.get("FACTORY_GH_BIN", "gh"),
    }

    if step.get("ignore_term"):
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
    emit({"type": "thread.started", "thread_id": f"stub-{stage}-{attempt}"})
    emit({"type": "turn.started"})
    emit({"type": "stub.unknown_event", "detail": "ignored by the parser"})
    if step.get("early_usage"):
        emit({"type": "turn.completed", "usage": step["early_usage"]})
    for status in step.get("spawn_agents", []):
        emit({"type": "item.completed", "item": {"type": "collab_tool_call", "tool": "spawn_agent", "status": status}})
    if step.get("sleep"):
        time.sleep(float(step["sleep"]))

    for relative, content in fill(step.get("files", {}), context).items():
        target = Path(relative) if os.path.isabs(relative) else worktree / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(content, encoding="utf-8")
    for command in fill(step.get("run", []), context):
        emit({"type": "item.started", "item": {"type": "command_execution", "command": " ".join(command)}})
        completed = subprocess.run(command, cwd=worktree, capture_output=True, text=True)
        emit({"type": "item.completed", "item": {"type": "command_execution", "command": " ".join(command),
                                                   "exit_code": completed.returncode, "status": "completed"}})
        if completed.returncode != 0:
            sys.stderr.write(completed.stdout + completed.stderr)

    plan_dir = worktree / ".dev" / context["plan"]
    result = step.get("result", {})
    result_path = plan_dir / f"{stage}-result.json"
    if result == "corrupt":
        plan_dir.mkdir(parents=True, exist_ok=True)
        result_path.write_text("{not json", encoding="utf-8")
    elif result != "omit":
        payload = {"schema": 2, "stage": stage, "status": "done", "reason": "stub finished", "conditions": []}
        payload.update(fill(result, context))
        plan_dir.mkdir(parents=True, exist_ok=True)
        result_path.write_text(json.dumps(payload), encoding="utf-8")

    message = step.get("message", f"{stage} attempt {attempt} finished")
    emit({"type": "item.completed", "item": {"type": "agent_message", "text": message}})
    tokens = int(step.get("tokens", 1000))
    if step.get("turn_failed"):
        emit({"type": "turn.failed", "error": {"message": step["turn_failed"]}})
    elif step.get("usage") == "omit":
        emit({"type": "turn.completed"})
    else:
        emit({"type": "turn.completed", "usage": step.get("usage") or {
            "input_tokens": tokens, "cached_input_tokens": 0, "output_tokens": tokens // 10}})
    if last_message:
        Path(last_message).write_text(message + "\n", encoding="utf-8")
    if step.get("truncate"):
        sys.stdout.write('{"type": "item.comp')
        sys.stdout.flush()
    return int(step.get("exit", 0))


if __name__ == "__main__":
    sys.exit(main())
