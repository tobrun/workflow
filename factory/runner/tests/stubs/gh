#!/usr/bin/env python3
"""Stub `gh` backed by a JSON state file at $FACTORY_GH_STATE.

State: {"auth": true, "repo": "stub/repo", "prs": [...], "checks": {"<number>": [...]},
        "default_checks": [...], "checks_delay": {"<number>": polls}, "mutations": [...]}

A PR's `headRefOid` is always read live from its remote (`git ls-remote`), so pushes after
creation move it exactly as they move a real PR. `checks_delay` makes `pr checks` report
no checks for that many calls, as right after a push. `body` is kept from --body-file.
"""

import fcntl
import json
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

FIELDS = ("number", "url", "isDraft", "headRefName", "state", "mergedAt", "title", "baseRefName", "headRefOid", "body",
          "isCrossRepository", "reviewDecision")


def option(argv, flag, default=None):
    if flag in argv:
        index = argv.index(flag)
        if index + 1 < len(argv):
            return argv[index + 1]
    return default


def remote_head(branch):
    remote = subprocess.run(["git", "ls-remote", "origin", f"refs/heads/{branch}"], capture_output=True, text=True).stdout
    return remote.split()[0] if remote.strip() else None


def pick(pr, fields):
    names = fields.split(",") if fields else FIELDS
    live = dict(pr)
    if "headRefOid" in names:
        live["headRefOid"] = pr.get("headRefOid_override") or remote_head(pr["headRefName"])
    live.setdefault("isCrossRepository", False)
    return {name: live.get(name) for name in names}


def body_from(argv):
    path = option(argv, "--body-file")
    return Path(path).read_text(encoding="utf-8") if path and Path(path).is_file() else option(argv, "--body", "")


def current_branch():
    return subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"], capture_output=True, text=True).stdout.strip()


def main():
    argv = sys.argv[1:]
    path = Path(os.environ.get("FACTORY_GH_STATE", "gh-state.json"))
    log = os.environ.get("FACTORY_STUB_LOG")
    if log:
        with open(log, "a", encoding="utf-8") as handle:
            handle.write(json.dumps({"tool": "gh", "argv": argv, "cwd": os.getcwd()}) + "\n")
    lock = open(str(path) + ".lock", "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    state = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
    state.setdefault("auth", True)
    state.setdefault("prs", [])
    state.setdefault("checks", {})
    state.setdefault("mutations", [])

    def save():
        path.write_text(json.dumps(state, indent=2), encoding="utf-8")

    def find(number):
        if number is None:
            branch = current_branch()
            matches = [p for p in state["prs"] if p["headRefName"] == branch and p["state"] == "OPEN"]
            return matches[0] if matches else None
        return next((p for p in state["prs"] if str(p["number"]) == str(number)), None)

    command = argv[:2]
    positional = argv[2] if len(argv) > 2 and not argv[2].startswith("-") else None
    operation = " ".join(command)
    failures = state.setdefault("fail", {})
    if failures.get(operation, 0) > 0:
        failures[operation] -= 1
        save()
        print(f"stub gh: HTTP 502 Bad Gateway ({operation})", file=sys.stderr)
        return 1
    interrupted = state.setdefault("fail_after", {})
    if command == ["auth", "token"]:
        if state["auth"]:
            print("gho_stubtoken")
            return 0
        print("no oauth token found for github.com", file=sys.stderr)
        return 1
    if command == ["auth", "status"]:
        if state["auth"]:
            print("Logged in to github.com as stub")
            return 0
        print("You are not logged into any GitHub hosts.", file=sys.stderr)
        return 1
    if command == ["pr", "list"]:
        head = option(argv, "--head")
        wanted = option(argv, "--state", "open").upper()
        prs = [p for p in state["prs"] if (head is None or p["headRefName"] == head)
               and (wanted == "ALL" or p["state"] == wanted)]
        print(json.dumps([pick(p, option(argv, "--json")) for p in prs]))
        return 0
    if command == ["pr", "view"]:
        pr = find(positional)
        if pr is None:
            print("no pull requests found", file=sys.stderr)
            return 1
        print(json.dumps(pick(pr, option(argv, "--json"))))
        return 0
    if command == ["repo", "view"]:
        print(json.dumps({"nameWithOwner": state.get("repo", "stub/repo")}))
        return 0
    if command == ["pr", "checks"]:
        pr = find(positional)
        if pr is None:
            print("no pull requests found", file=sys.stderr)
            return 1
        delay = state.setdefault("checks_delay", {}).get(str(pr["number"]), 0)
        if delay > 0:
            state["checks_delay"][str(pr["number"])] = delay - 1
            save()
            print(f"no checks reported on the '{pr['headRefName']}' branch", file=sys.stderr)
            return 1
        checks = state["checks"].get(str(pr["number"]), [])
        if not checks:
            print(f"no checks reported on the '{pr['headRefName']}' branch", file=sys.stderr)
            return 1
        print(json.dumps(checks))
        buckets = {c.get("bucket") for c in checks}
        return 1 if "fail" in buckets else (8 if "pending" in buckets else 0)
    if command == ["pr", "create"]:
        head = option(argv, "--head") or current_branch()
        number = len(state["prs"]) + 1
        pr = {"number": number, "url": f"https://github.com/stub/repo/pull/{number}", "isDraft": "--draft" in argv,
              "headRefName": head, "baseRefName": option(argv, "--base", "main"), "state": "OPEN",
              "mergedAt": None, "title": option(argv, "--title", ""), "body": body_from(argv)}
        state["prs"].append(pr)
        if state.get("default_checks") is not None:
            state["checks"][str(number)] = state["default_checks"]
        state["mutations"].append({"op": "create", "number": number, "draft": pr["isDraft"], "head": head})
        if interrupted.get(operation, 0) > 0:
            interrupted[operation] -= 1
            save()
            print("stub gh: connection reset after the request was sent", file=sys.stderr)
            return 1
        save()
        print(pr["url"])
        return 0
    if command == ["pr", "edit"]:
        pr = find(positional)
        if pr is None:
            return 1
        if option(argv, "--body-file") or option(argv, "--body"):
            pr["body"] = body_from(argv)
        state["mutations"].append({"op": "edit", "number": pr["number"]})
        save()
        print(pr["url"])
        return 0
    if command == ["pr", "comment"]:
        pr = find(positional)
        if pr is None:
            return 1
        pr.setdefault("comments", []).append(body_from(argv))
        state["mutations"].append({"op": "comment", "number": pr["number"]})
        save()
        return 0
    if command == ["pr", "ready"]:
        pr = find(positional)
        if pr is None:
            return 1
        pr["isDraft"] = "--undo" in argv
        state["mutations"].append({"op": "ready", "number": pr["number"], "undo": "--undo" in argv})
        save()
        return 0
    if command == ["pr", "merge"]:
        pr = find(positional)
        if pr is None:
            return 1
        pr["state"] = "MERGED"
        pr["mergedAt"] = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        state["mutations"].append({"op": "merge", "number": pr["number"]})
        save()
        return 0
    print(f"stub gh: unsupported {argv}", file=sys.stderr)
    return 64


if __name__ == "__main__":
    sys.exit(main())
